# Normalize line endings for all text files
* text=auto

# Force LF for JS/JSX/JSON/CSS/HTML/MD source files
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf

# Windows scripts — keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf